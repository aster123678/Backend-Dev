NODE_ENV=production
APP_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://prod-user:${PROD_DB_PASSWORD}@prod-cluster.mongodb.net/transactions_prod
LOG_LEVEL=error
API_BASE_URL=https://api.company.com
FEATURE_FAST_SETTLEMENT=true
